{
  "name": "opencode-telegram-bridge",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Telegram bridge for a local OpenCode instance: send prompts to sessions, approve permissions, get notifications.",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opencode/client": "^2.0.27",
    "grammy": "^1.46.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
