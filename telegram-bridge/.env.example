# Telegram bot tokeni (BotFather'dan alınır: /newbot)
TELEGRAM_BOT_TOKEN=

# Bot'un yanıt vereceği Telegram kullanıcı ID'leri (virgülle ayırın).
# ID'nizi bilmiyorsanız bot'a /start yazın; bot size ID'nizi söyler.
TELEGRAM_ALLOWED_IDS=

# İsteğe bağlı: OpenCode servis URL'i. Boş bırakılırsa arka plan servisi otomatik bulunur/başlatılır.
# OPENCODE_URL=http://127.0.0.1:4096

# İsteğe bağlı: Günlük ayrıntısı (debug | info | warn)
# LOG_LEVEL=info

# İsteğe bağlı: yerel durum ucu (uygulamanın "Telegram durumu" kontrolü için).
# Varsayılan yalnızca bu bilgisayardan erişilir. Aynı Wi-Fi'daki telefondan
# kontrol etmek için 0.0.0.0 yapın; yanıt SIR İÇERMEZ (yalnızca durum bilgisi).
# TELEGRAM_STATUS_HOST=127.0.0.1
# TELEGRAM_STATUS_PORT=49375